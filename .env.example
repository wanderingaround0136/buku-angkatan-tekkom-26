# ─────────────────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────
# Pooler (port 6543) — dipakai runtime aplikasi
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Direct (port 5432) — dipakai drizzle-kit untuk migrasi/push
DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────
# Auth (custom JWT via jose) — WAJIB
# Generate: openssl rand -base64 32
# ─────────────────────────────────────────────────────────
AUTH_JWT_SECRET=""

# ─────────────────────────────────────────────────────────
# Email OTP (Resend) — opsional (wajib untuk uji login admin)
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ─────────────────────────────────────────────────────────
# Object Storage (Cloudflare R2) — opsional (wajib untuk uji upload)
# ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""
